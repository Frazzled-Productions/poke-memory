# Local environment. Copy to .env.local for build-time values (NEXT_PUBLIC_*), and put the
# Worker secrets in a gitignored .dev.vars, which `wrangler dev` and `next dev` (through
# initOpenNextCloudflareForDev) read. Use random local test values only; never real secrets.
# The list of Worker secrets lives in the header comment of wrangler.jsonc.
#
# .dev.vars (Worker secrets, one NAME=value per line):
#   BETTER_AUTH_SECRET=
#   GITHUB_CLIENT_ID=
#   GITHUB_CLIENT_SECRET=
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
#   CRON_SHARED_SECRET=
#   VAPID_PRIVATE_KEY=
#   VAPID_SUBJECT=
#   DISCORD_NOTIFY_WEBHOOK_URL=
#   DISCORD_DIGEST_WEBHOOK_URL=
#   RATE_LIMIT_SALT=
#   SENTRY_TRACES_SAMPLE_RATE=   (optional)
# The local D1 database needs no credentials: `npm run db:migrate:local` creates it.

# Production URL used to build OAuth redirect URIs.
# Omit in development (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Web Push public key (the pair of VAPID_PRIVATE_KEY above).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Google Cloud Text-to-Speech API key.
# Only needed to regenerate the pre-built audio files in public/audio/names/.
# Run: npm run seed:tts
# This key is NEVER loaded at runtime - the app serves the static MP3s directly.
GOOGLE_CLOUD_TTS_API_KEY=
