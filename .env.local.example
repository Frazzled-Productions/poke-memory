# Environment variables for Supabase integration
# Copy this file to .env.local and fill in your project values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production URL used to build OAuth redirect URIs.
# Omit in development (defaults to http://localhost:3000).
# Required in production -- set to your domain, e.g. https://your-app.vercel.app
# Also add this to your Vercel environment variables.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# GitHub OAuth redirect URI -- configure this in your Supabase project dashboard:
#   Authentication > URL Configuration > Redirect URLs
# Development:  http://localhost:3000/api/auth/callback
# Production:   https://your-production-domain.com/api/auth/callback

# Google Cloud Text-to-Speech API key.
# Only needed to regenerate the pre-built audio files in public/audio/names/.
# Run: npm run seed:tts
# This key is NEVER loaded at runtime — the app serves the static MP3s directly.
GOOGLE_CLOUD_TTS_API_KEY=
