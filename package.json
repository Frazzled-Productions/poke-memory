{
  "name": "poke-memory",
  "version": "0.10.22",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run lint:em-dash",
    "lint:em-dash": "node scripts/check-no-em-dash.mjs",
    "seed": "node scripts/seed-pokemon.mjs",
    "seed:split": "node scripts/split-seed.mjs",
    "seed:locale-names": "node scripts/seed-locale-names.mjs",
    "seed:sprites": "node scripts/optimise-sprites.mjs",
    "generate:scope-lookup": "node scripts/generate-scope-lookup.mjs",
    "audit:forms": "node scripts/audit-form-categories.mjs",
    "seed:tts": "node --env-file-if-exists=.env.local scripts/seed-tts-audio.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:diff": "git diff origin/qa...HEAD | node scripts/diff-coverage.mjs",
    "test:integration": "VITEST_INTEGRATION=1 vitest run --project integration",
    "test:e2e": "playwright test --project=chromium --project=mobile-safari --project=desktop-webkit --project=mobile-chrome",
    "test:visual": "playwright test --project=visual-chromium --project=visual-webkit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-spaced-repetition/binding": "^0.3.1",
    "@serwist/turbopack": "^9.5.11",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "esbuild-wasm": "^0.28.0",
    "idb": "^8.0.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.1",
    "serwist": "^9.5.11",
    "ts-fsrs": "^5.4.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "pg": "^8.21.0",
    "pinyin-pro": "3.28",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10",
    "wanakana": "^5.3.1"
  }
}
