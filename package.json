{
  "name": "poke-memory",
  "version": "0.11.8",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "next build && node scripts/build-sw.mjs",
    "start": "next start",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lint": "eslint && npm run lint:em-dash && npm run lint:i18n && npm run lint:pseudo-locale && npm run lint:changelog && npm run lint:agents-size",
    "lint:em-dash": "node scripts/check-no-em-dash.mjs",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "lint:pseudo-locale": "node scripts/generate-pseudo-locale.mjs --check",
    "lint:changelog": "node scripts/lint-changelog-fragments.mjs",
    "lint:agents-size": "node scripts/lint-agents-size.mjs",
    "seed": "node scripts/seed-pokemon.mjs",
    "seed:split": "node scripts/split-seed.mjs",
    "seed:locale-names": "node scripts/seed-locale-names.mjs",
    "seed:sprites": "node scripts/optimise-sprites.mjs",
    "generate:scope-lookup": "node scripts/generate-scope-lookup.mjs",
    "generate:pseudo-locale": "node scripts/generate-pseudo-locale.mjs",
    "test:i18n-leak": "vitest run --project jsdom --reporter=verbose components/**/*.i18n-leak.test.tsx",
    "audit:forms": "node scripts/audit-form-categories.mjs",
    "seed:all": "node scripts/seed-all.mjs",
    "seed:validate": "node scripts/seed-validate.mjs",
    "seed:tts": "node --env-file-if-exists=.env.local scripts/seed-tts-audio.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "animations": "node scripts/capture-animations.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:diff-coverage": "git diff ${DIFF_COVERAGE_BASE:-origin/qa}...HEAD | node scripts/diff-coverage.mjs",
    "test:integration": "VITEST_INTEGRATION=1 vitest run --project integration",
    "test:e2e": "playwright test --project=chromium --project=mobile-safari --project=desktop-webkit --project=mobile-chrome",
    "test:visual": "playwright test --project=visual-chromium --project=visual-webkit",
    "typecheck": "tsc --noEmit",
    "qa:seed-cloud": "node scripts/run-qa-seed-cloud.mjs",
    "pre-pr": "node scripts/pre-pr.mjs"
  },
  "dependencies": {
    "@open-spaced-repetition/binding": "^0.5.0",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.107.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "esbuild-wasm": "^0.28.0",
    "idb": "^8.0.3",
    "next": "16.2.10",
    "next-intl": "^4.13.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.8.1",
    "serwist": "^9.5.11",
    "ts-fsrs": "^5.4.1",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@serwist/build": "^9.5.11",
    "@serwist/turbopack": "^9.5.11",
    "@serwist/utils": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.8",
    "browserslist": "^4.28.2",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "pg": "^8.21.0",
    "pinyin-pro": "3.28",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10",
    "wanakana": "^5.3.1"
  }
}
