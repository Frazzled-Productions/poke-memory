{
  "name": "poke-memory",
  "version": "0.11.15",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "node scripts/generate-changelog-module.mjs && node scripts/build-fsrs-optimiser.mjs && next dev",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "node scripts/generate-changelog-module.mjs && node scripts/build-fsrs-optimiser.mjs && next build && node scripts/build-sw.mjs",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:upload-preview": "opennextjs-cloudflare upload --env preview --preview-alias pr-$PR_NUMBER",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lint": "eslint && npm run lint:em-dash && npm run lint:i18n && npm run lint:pseudo-locale && npm run lint:changelog && npm run lint:agents-size && npm run lint:playwright-pin && npm run lint:skills-layout && npm run lint:workflow-markers && npm run lint:scoped-queries",
    "lint:em-dash": "node scripts/check-no-em-dash.mjs",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "lint:pseudo-locale": "node scripts/generate-pseudo-locale.mjs --check",
    "lint:changelog": "node scripts/lint-changelog-fragments.mjs",
    "lint:agents-size": "node scripts/lint-agents-size.mjs",
    "lint:playwright-pin": "node scripts/check-playwright-pin.mjs",
    "lint:skills-layout": "node scripts/check-skills-layout.mjs",
    "lint:workflow-markers": "node scripts/lint-workflow-marker-lookups.mjs",
    "seed": "node scripts/seed-pokemon.mjs",
    "seed:split": "node scripts/split-seed.mjs",
    "seed:locale-names": "node scripts/seed-locale-names.mjs",
    "seed:sprites": "node scripts/optimise-sprites.mjs",
    "seed:palettes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-palettes.mjs",
    "generate:scope-lookup": "node scripts/generate-scope-lookup.mjs",
    "generate:pseudo-locale": "node scripts/generate-pseudo-locale.mjs",
    "test:i18n-leak": "vitest run --project jsdom --reporter=verbose components/**/*.i18n-leak.test.tsx",
    "audit:forms": "node scripts/audit-form-categories.mjs",
    "seed:all": "node scripts/seed-all.mjs",
    "seed:validate": "node scripts/seed-validate.mjs",
    "seed:tts": "node --env-file-if-exists=.env.local scripts/seed-tts-audio.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "animations": "node scripts/capture-animations.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:diff-coverage": "git diff ${DIFF_COVERAGE_BASE:-origin/qa}...HEAD | node scripts/diff-coverage.mjs",
    "test:e2e": "playwright test --project=chromium --project=mobile-safari --project=desktop-webkit --project=mobile-chrome",
    "test:visual": "playwright test --project=visual-chromium --project=visual-webkit",
    "typecheck": "node scripts/generate-changelog-module.mjs && tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "pre-pr": "node scripts/pre-pr.mjs",
    "lint:scoped-queries": "node scripts/check-scoped-queries.mjs"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@napi-rs/wasm-runtime": "^1.2.7",
    "@opennextjs/cloudflare": "^1.20.17",
    "@sentry/nextjs": "^11.1.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.22",
    "esbuild-wasm": "^0.28.2",
    "idb": "^8.0.3",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "serwist": "^9.5.11",
    "ts-fsrs": "^5.4.2",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "postcss": ">=8.5.23",
    "@babel/core": "^7.29.6",
    "browserslist": "$browserslist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@playwright/test": "^1.63.0",
    "@serwist/build": "^9.5.11",
    "@serwist/turbopack": "^9.5.13",
    "@serwist/utils": "^9.5.13",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "browserslist": "^4.28.8",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "pinyin-pro": "3.29",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.2",
    "wait-on": "^9.5.1",
    "wanakana": "^5.3.1",
    "wrangler": "^4.161.0"
  }
}
