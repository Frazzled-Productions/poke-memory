# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# generated service worker (built by scripts/build-sw.mjs after `next build`;
# regenerated on every build incl. CI/Vercel, so not committed, #1752)
/public/sw/

# generated FSRS optimiser worker bundles + wasm (scripts/build-fsrs-optimiser.mjs,
# run by `npm run build` and `npm run dev`)
/public/fsrs/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code background-job worktrees
/.claude/worktrees/

# art generation pipeline (#831): local venv and raw/intermediate renders are
# regenerated by tools/art/, never committed. Only the final PNGs under
# public/badges/ (and any other final asset dir the pipeline targets) ship.
/tools/art/.venv/
/tools/art/out/
__pycache__/

# generated from CHANGELOG.md by scripts/generate-changelog-module.mjs (Workers have no filesystem)
/lib/changelog/changelog.generated.ts

# Cloudflare: OpenNext build output and wrangler local state (D1, R2)
/.open-next/
/.wrangler/
/.dev.vars*
