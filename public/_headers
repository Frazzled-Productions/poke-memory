# Cloudflare static-asset headers (Workers assets). Mirrors the headers() block
# in next.config.ts, which Workers assets do not apply to public/ files: the
# service worker must always revalidate (#1749) and claim the whole site.
/sw/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/sw/sw.js.map
  Cache-Control: no-cache

# Cloudflare Workers static-asset headers. Mirrors the /fsrs/* rule in
# next.config.ts headers(), which the Next server applies only to requests it
# handles; static assets are served before it runs.
/fsrs/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
