{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/mirror-todos-to-comment.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git fetch origin main --quiet 2>/dev/null || true; if [ \"$(git symbolic-ref --short HEAD 2>/dev/null)\" = \"main\" ] && git diff --quiet && git diff --cached --quiet; then git merge --ff-only origin/main --quiet 2>/dev/null || true; fi",
            "timeout": 15
          },
          {
            "type": "command",
            "command": ".claude/hooks/prune-worktrees.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh api repos/*)",
      "Bash(gh label list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(node *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(wc *)",
      "Bash(printenv *)",
      "Bash(sleep *)",
      "Bash(echo)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(test *)",
      "Bash(true)",
      "Bash(false)",
      "Edit(*)",
      "Write(*)",
      "Task(*)"
    ]
  }
}